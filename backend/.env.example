PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/breast_cancer_ai
# Optional Supabase persistence (takes over if MongoDB is unreachable)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# REQUIRED: generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000
# Optional Sentry monitoring
SENTRY_DSN=
